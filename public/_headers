# This file is the ONLY definition of Content-Security-Policy in the repo.
# Cache-Control lives in netlify.toml. Never add Cache-Control to the /* rule.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://scstatehouse.gov https://*.scstatehouse.gov https://scdailygazette.com https://cms.deflock.me https://upload.wikimedia.org https://commons.wikimedia.org; connect-src 'self' https://cms.deflock.me https://tiles.openfreemap.org https://*.openfreemap.org https://cloud.umami.is https://api-gateway.umami.dev; frame-src 'self'; worker-src blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
