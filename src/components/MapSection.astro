---
import impactStats from '../data/impact-stats.json';

// Statewide figures for the map statline. Computed at build into
// impact-stats.json (design §4.1); never hardcode a camera number in markup.
const scTotal = impactStats.scTotal.toLocaleString('en-US');
const jurisdictions = impactStats.jurisdictions.toLocaleString('en-US');
---

<section id="map" aria-labelledby="map-section-heading"
  class="bg-base-100 border-t border-[rgba(255,255,255,0.10)] relative overflow-hidden scroll-mt-20"
  style="padding-block: clamp(3rem, 7vw, 5.5rem);">
  <div class="mx-auto w-full max-w-[1120px] px-[clamp(1rem,4vw,2.25rem)]">

    <!-- Heading -->
    <div data-reveal="up" class="max-w-[62ch] mb-10">
      <h2 id="map-section-heading" class="text-white font-semibold tracking-[-0.015em] leading-[1.12]"
          style="font-size:clamp(1.5rem,3.4vw,2.15rem);text-wrap:balance;">
        These cameras are watching your South Carolina town right now.
      </h2>
    </div>

    <!-- Map + side column -->
    <div data-reveal="up" class="map-layout">

      <!-- Map frame (left) -->
      <div class="map-embed">
        <!-- Mobile: tap-to-load placeholder (hidden at md+, where the map shows directly) -->
        <div id="map-button-container" class="md:hidden absolute inset-0 flex items-center justify-center bg-base-200 p-8 text-center">
          <button
            id="map-toggle"
            type="button"
            class="inline-block bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold text-sm uppercase tracking-[0.05em] px-8 py-4 transition-colors cursor-pointer"
          >
            Explore the camera map &rarr;&#xFE0E;
          </button>
        </div>

        <!-- Live map (hidden below md until the toggle reveals it) -->
        <div id="map-frame" class="hidden md:block absolute inset-0">
          <div class="map-badge" aria-hidden="true">
            <span class="map-live-dot"></span>
            ALPR Network
          </div>
          <button id="scroll-toggle" type="button" class="map-scroll-btn" aria-pressed="false">
            <svg class="scroll-btn-icon" width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
              <rect x="2" y="4.5" width="7" height="5.5" rx="0.75" stroke="currentColor" stroke-width="1.2"/>
              <path d="M3.5 4.5V3a2 2 0 0 1 4 0v1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            <span class="scroll-btn-label">Enable scroll zoom</span>
          </button>
          <div id="map-container" style="height: 100%; clip-path: inset(0);">
            <div id="camera-map" class="map-dark" style="width: 100%; height: 100%;" role="application" aria-label="ALPR Camera Map" tabindex="-1"></div>
          </div>
        </div>
      </div>

      <!-- Side column (right) -->
      <div class="map-side">
        <p class="map-statline"><span class="n"><span class="sr-only">{scTotal}</span><span aria-hidden="true" data-count-up>{scTotal}</span></span> cameras &middot; <span class="n"><span class="sr-only">{jurisdictions}</span><span aria-hidden="true" data-count-up>{jurisdictions}</span></span> jurisdictions</p>
        <p class="map-caption">Pan across the state, tap any dot to see the vendor, operating agency, and direction each camera faces.</p>
      </div>

    </div>

    <!-- Attribution -->
    <div class="mt-8 pt-6 border-t border-[rgba(255,255,255,0.10)]">
      <p class="text-[#a3a3a3] text-xs">
        Map tiles by <a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &middot; <a href="https://openmaptiles.org" target="_blank" rel="noopener">OpenMapTiles</a> &middot; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">&copy; OpenStreetMap</a>
      </p>
      <p class="text-[#9a9a9a] text-xs mt-1">
        Camera data from <a href="https://deflock.org" target="_blank" rel="noopener" class="text-[#fbbf24] hover:text-[#fcd34d] transition-colors">Deflock.org</a>, a community-sourced map of Flock Safety camera locations. Help keep it updated by reporting cameras you find.
      </p>
    </div>

  </div>
</section>

<style>
  /* Map + side-column layout: one column on phones, map-left / info-right at
     >= 900px. The 900px breakpoint is bespoke (not a Tailwind default), so the
     grid lives here in scoped CSS. */
  .map-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }
  @media (min-width: 900px) {
    .map-layout {
      grid-template-columns: 1.7fr 1fr;
      align-items: center;
    }
  }

  /* Bordered map frame. width:100% keeps the width definite (= its grid track)
     so aspect-ratio derives the HEIGHT from it. Without a definite width,
     aspect-ratio + min-height derive the WIDTH from the 320px floor (~569px),
     which overflows narrow tracks and scrolls the body. min-width:0 lets the
     grid track shrink below the frame's intrinsic content (repo grid gotcha). */
  .map-embed {
    position: relative;
    width: 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
    min-height: 320px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.45rem;
    overflow: hidden;
    background: radial-gradient(120% 130% at 30% 20%, #1c1c1c 0%, #141414 55%, #0d0d0d 100%);
  }

  .map-side {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .map-statline {
    font-family: 'Instrument Sans Variable', sans-serif;
    font-size: 0.9rem;
    color: #e8e8e8;
    letter-spacing: 0.02em;
  }
  .map-statline .n {
    color: #ef4444; /* red — ≥4.5:1 on #171717 */
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .map-caption {
    font-size: 0.9rem;
    color: #a3a3a3;
    line-height: 1.6;
    max-width: 46ch;
  }

  /* Scroll-to-zoom toggle button */
  .map-scroll-btn {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: 'Instrument Sans Variable', sans-serif;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c0c0c0;
    background: rgba(13, 13, 13, 0.9);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .map-scroll-btn:hover {
    color: #e8e8e8;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .map-scroll-btn[aria-pressed="true"] {
    color: #dc2626;
    border-color: rgba(220, 38, 38, 0.5);
  }
  .map-scroll-btn[aria-pressed="true"] .scroll-btn-icon {
    color: #dc2626;
  }
  .scroll-btn-icon {
    flex-shrink: 0;
    color: #a3a3a3;
    transition: color 0.15s;
  }
  @media (max-width: 767px) {
    .map-scroll-btn {
      display: none;
    }
  }

  /* ALPR Network badge overlay */
  .map-badge {
    position: absolute;
    top: 12px;
    left: 16px;
    z-index: 10;
    font-family: 'Instrument Sans Variable', sans-serif;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e8e8e8;
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .map-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #dc2626;
    flex-shrink: 0;
    animation: map-dot-blink 2s ease-in-out infinite;
  }

  @keyframes map-dot-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-live-dot { animation: none; }
  }

  /* MapLibre control + popup chrome and the camera popup body live in
     src/styles/global.css under `.map-dark` / `.camera-popup*`, so a second
     map container is not left with unstyled default controls. */
</style>

<script>
  import type { MapHandle } from '../scripts/map/core.js';
  import type { GeoJSONSource } from 'maplibre-gl';
  import type { DeflockCamera } from '../scripts/map/tile-loader.js';
  import { observeCountUps } from '../scripts/count-up.js';

  // Open on Greenville (the Upstate has the densest deployment); users pan and
  // zoom out from there to explore the rest of the state.
  const MAP_CENTER: [number, number] = [-82.39, 34.85];
  const MAP_ZOOM = 11;

  let mapReady: Promise<MapHandle> | null = null;

  async function initCameraMap(): Promise<MapHandle> {
    await import('maplibre-gl/dist/maplibre-gl.css');
    const { createMap } = await import('../scripts/map/core.js');
    const { addCameraLayers, parseDirection } = await import('../scripts/map/layers/cameras.js');
    const { createTileLoader } = await import('../scripts/map/tile-loader.js');

    const handle = createMap({
      container: 'camera-map',
      style: '/map-style.json',
      center: MAP_CENTER,
      zoom: MAP_ZOOM,
    });

    // EXACT property mapping the popups, direction cones, and OSM links depend
    // on — unchanged from the previous loader. Do not alter fields.
    const toGeoJSON = (cameras: DeflockCamera[]): GeoJSON.FeatureCollection => ({
      type: 'FeatureCollection',
      features: cameras.map((cam) => {
        const direction = parseDirection(cam.tags);
        return {
          type: 'Feature' as const,
          geometry: {
            type: 'Point' as const,
            coordinates: [cam.lon, cam.lat],
          },
          properties: {
            id: cam.id,
            direction,
            hasDirection: direction !== null,
            manufacturer: cam.tags?.manufacturer || null,
            operator: cam.tags?.operator || null,
            wikimedia_commons: cam.tags?.wikimedia_commons || null,
          },
        };
      }),
    });

    handle.map.on('load', () => {
      // Source + layers are added exactly once, seeded empty. All data arrives
      // through source.setData() below — never re-add the source or layers.
      addCameraLayers(handle.map, { type: 'FeatureCollection', features: [] });

      const loader = createTileLoader({
        onUpdate(cameras) {
          const source = handle.map.getSource('cameras') as GeoJSONSource | undefined;
          source?.setData(toGeoJSON(cameras));
        },
      });

      const viewportBounds = () => {
        const b = handle.map.getBounds();
        return { west: b.getWest(), south: b.getSouth(), east: b.getEast(), north: b.getNorth() };
      };

      // Initial load is immediate; moveend is debounced on a 250 ms trailing
      // edge so a continuous pan/zoom gesture issues one trailing load
      // instead of one per intermediate moveend.
      void loader.loadViewport(viewportBounds());
      let moveendTimer: ReturnType<typeof setTimeout> | undefined;
      handle.map.on('moveend', () => {
        clearTimeout(moveendTimer);
        moveendTimer = setTimeout(() => void loader.loadViewport(viewportBounds()), 250);
      });
    });

    return handle;
  }

  /** Idempotent: every caller shares one map instance. */
  function loadMap(): Promise<MapHandle> {
    if (!mapReady) mapReady = initCameraMap();
    return mapReady;
  }

  // Shared "open-map" operation (design §2.4 decision D3). One code path used by
  // the mobile toggle and #camera-map hash visits:
  // reveal the mobile frame if it is still hidden, initialize + resize the map,
  // scroll it into view, then move focus to it. On desktop the frame is already
  // visible and initialized, so this reduces to scroll + focus.
  async function openMap(opts: { track?: boolean } = {}): Promise<void> {
    if (opts.track && typeof umami !== 'undefined') umami.track('map-opened-mobile');

    document.getElementById('map-button-container')?.classList.add('hidden');
    const frame = document.getElementById('map-frame');
    if (frame) {
      frame.classList.remove('hidden');
      frame.classList.add('block');
    }

    const handle = await loadMap();
    handle.resize();

    const target = document.getElementById('camera-map');
    if (target) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      // #camera-map carries tabindex="-1", so it is programmatically focusable;
      // preventScroll keeps the smooth scroll we just started.
      target.focus({ preventScroll: true });
    }
  }

  // Desktop: lazy-load when the map scrolls into view.
  const mapContainer = document.getElementById('camera-map');
  if (mapContainer && window.matchMedia('(min-width: 768px)').matches) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        observer.disconnect();
        loadMap();
      }
    }, { rootMargin: '200px' });
    observer.observe(mapContainer);
  }

  // Handle resize mobile -> desktop
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches && !mapReady) loadMap();
  });

  // Call site (a): the mobile toggle button — keeps its umami event.
  document.getElementById('map-toggle')?.addEventListener('click', () => {
    void openMap({ track: true });
  });

  // Call site (b): initial load + hashchange for the legacy #camera-map anchor,
  // so a /#camera-map deep link lands on the visible, initialized map (on mobile
  // it reveals + initializes first).
  function handleCameraMapHash(): void {
    if (window.location.hash === '#camera-map') void openMap();
  }
  window.addEventListener('hashchange', handleCameraMapHash);
  handleCameraMapHash();

  // Scroll-to-zoom toggle
  document.getElementById('scroll-toggle')?.addEventListener('click', async () => {
    const btn = document.getElementById('scroll-toggle') as HTMLButtonElement;
    const handle = await loadMap();
    const enabled = handle.toggleScrollZoom();
    btn.setAttribute('aria-pressed', String(enabled));
    btn.querySelector('.scroll-btn-label')!.textContent = enabled ? 'Disable scroll zoom' : 'Enable scroll zoom';
  });

  // Count-up on the map statline numbers (shared util, fires once on view).
  observeCountUps(document.querySelectorAll<HTMLElement>('.map-statline [data-count-up]'));
</script>
