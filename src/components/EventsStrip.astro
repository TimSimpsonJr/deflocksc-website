---
// Events strip — the "depth" tier of the conversion zone (§2.6b). Baked at build
// only (no client overlay merge; the weekly fold keeps it fresh). It reuses the
// exact events-view pipeline the /events page uses, so the two never drift:
//   validate baked events.json -> push council series -> expandAll over a bounded
//   12-month horizon -> splitByToday -> collapseSeries (keeps each series' NEXT
//   upcoming occurrence). Council meetings are then capped so the ~83 standing
//   council series can't fill every slot forever.
import registry from '../data/registry.json';
import bakedEventsRaw from '../data/events.json';
import { toPublicEvent, type PublicEvent, type StoredEvent } from '../lib/public-event.js';
import { publicEventSchema } from '../lib/event-schema.js';
import { loadCouncilEvents } from '../lib/council-events.js';
import {
  expandAll,
  splitByToday,
  collapseSeries,
  addMonths,
  eventTypeLabel,
  monthAbbr,
  dayOfMonth,
  formatTime12,
  sortKey,
  type Occurrence,
} from '../lib/events-view.js';

// Baked events.json is validated with the shared strict publicEventSchema and
// projected through toPublicEvent — IDENTICAL to the /events page. The strict
// schema rejects a hand-edited record carrying a server-only field, and the
// council-type guard keeps curated council meetings on the loadCouncilEvents()
// path (where their `source`/`nths` survive) rather than this 13-field allowlist.
const bakedEvents: PublicEvent[] = (bakedEventsRaw as unknown[]).map((raw, index) => {
  const parsed = publicEventSchema.safeParse(raw);
  if (!parsed.success) {
    const issue = parsed.error.issues[0];
    const at = issue.path.length > 0 ? issue.path.join('.') : '_record';
    const detail = issue.code === 'unrecognized_keys' ? 'unexpected_field' : issue.message;
    throw new Error(
      `src/data/events.json: record ${index} at "${at}" failed strict validation (${detail})`,
    );
  }
  if (parsed.data.type === 'council') {
    throw new Error(
      `src/data/events.json: record ${index} has type "council"; curated council ` +
        `meetings belong in council-meetings.json, not events.json`,
    );
  }
  return toPublicEvent(parsed.data as unknown as StoredEvent);
});

// Curated council meetings, validated by the strict councilEventSchema (a bad
// entry throws and fails the build).
bakedEvents.push(...loadCouncilEvents());

const today = new Date().toISOString().slice(0, 10);
const horizonEnd = addMonths(today, 12);

// One row per distinct event, each carrying its NEXT upcoming occurrence date
// (collapseSeries keeps the first occurrence of each id, and the list is sorted
// ascending, so "first" is "soonest").
const upcomingSeries = collapseSeries(splitByToday(expandAll(bakedEvents, horizonEnd), today).upcoming);

// Composition (Fable#13): the ~83 standing council series would otherwise fill
// every slot forever. Real submitted organizing events take slots first; routine
// council meetings only fill the REMAINDER, capped at 2 (or 1 whenever any
// non-council event exists in the window) so they never dominate. Selection is
// order-preserving (both source lists are already in ascending sortKey order),
// then the SELECTED set is re-sorted by occurrence date for display. This is
// reproducible build to build: the deterministic sortKey tie-break (date -> time
// -> stable jurisdiction id) settles same-slot ordering with no extra logic.
const realEvents = upcomingSeries.filter((o) => o.event.type !== 'council');
const councilEvents = upcomingSeries.filter((o) => o.event.type === 'council');
const councilCap = realEvents.length > 0 ? 1 : 2;
const realSelected = realEvents.slice(0, 3);
const councilSelected = councilEvents.slice(0, Math.min(3 - realSelected.length, councilCap));
const strip: Occurrence[] = [...realSelected, ...councilSelected].sort((a, b) =>
  sortKey(a.date, a.event.time, a.event.id) < sortKey(b.date, b.event.time, b.event.id) ? -1 : 1,
);

// City display names, derived from registry.json exactly as /events does, so the
// location line reads "Greenville" not the raw "greenville" slug. registry.json
// is ~50 KB and stays at build time — nothing here reaches the client.
const cityNames: Record<string, string> = {};
for (const j of registry.jurisdictions as Array<Record<string, string>>) {
  if (j.type === 'place') {
    cityNames[j.id.split(':')[1]] = j.name.replace(/ (City|Town) Council$/, '');
  }
}

// Balanced grid: 1/2/3 cards each fill the row evenly rather than leaving an
// empty third column (the sparse 2-card render is the day-one norm, §2.6b).
const cols = Math.min(strip.length, 3);
---

{strip.length > 0 && (
  <section id="events" class="hp-band b1" aria-labelledby="events-heading">
    <div class="hp-shell">
      <div class="sec-head-wrap" data-reveal="up">
        <h2 id="events-heading" class="sec-title">Upcoming events: show up.</h2>
        <p class="sec-lead">The room is where it's decided. Here's where to be next.</p>
      </div>

      <ul class="estrip-grid" style={`--cols:${cols}`}>
        {strip.map((o, i) => {
          const e = o.event;
          const showLoc = e.type === 'public' || e.type === 'council';
          const badgeClass = e.type === 'council' ? 'badge badge-warning' : 'badge badge-outline';
          return (
            <li class="estrip-item" data-reveal="up" data-reveal-delay={i + 1}>
              <a href="/events" class="estrip-card">
                <span class="estrip-date">
                  <span class="d">{dayOfMonth(o.date).padStart(2, '0')}</span>
                  <span class="m">{`${monthAbbr(o.date)} ${o.date.slice(0, 4)}`}</span>
                </span>
                <span class={`${badgeClass} estrip-badge`}>{eventTypeLabel(e.type)}</span>
                <h3 class="estrip-title">{e.title}</h3>
                {e.description && <p class="estrip-desc">{e.description}</p>}
                {showLoc && (
                  <span class="estrip-loc">
                    <span aria-hidden="true">📍</span> {cityNames[e.city] ?? e.city} · {formatTime12(e.time)}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>

      <p class="see-all" data-reveal="up">
        <a href="/events" class="see-all-link">See all events <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
)}

<style>
  /* Band skeleton + shell (shared homepage rhythm, §1). */
  .hp-band {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .hp-band.b1 { background: #171717; }
  .hp-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.25rem);
  }

  .sec-head-wrap { max-width: 62ch; margin-bottom: 2.4rem; }
  .sec-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 3.4vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.12;
    color: #e8e8e8;
    text-wrap: balance;
  }
  .sec-lead { margin: 0; color: #a3a3a3; font-size: 1.02rem; max-width: 60ch; }

  /* Card grid: N columns for N cards (N <= 3), collapsing to one below 840px.
     minmax(0, 1fr) + min-width:0 on the card keeps long titles from widening a
     track past the viewport (known repo grid gotcha). */
  .estrip-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 840px) {
    .estrip-grid { grid-template-columns: 1fr; }
  }

  .estrip-item { min-width: 0; }

  /* The whole card is the link (§2.6b). base-200 panel, brightening on hover.
     The lift is gated to hover-capable pointers so touch never sticks. */
  .estrip-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    height: 100%;
    min-width: 0;
    padding: 1.05rem 1.1rem;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 0.3rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.18s cubic-bezier(0.23, 1, 0.32, 1),
                background 0.18s cubic-bezier(0.23, 1, 0.32, 1),
                transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .estrip-card:hover { border-color: rgba(255, 255, 255, 0.22); background: #1e1e1e; }
  .estrip-card:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
  @media (hover: hover) {
    .estrip-card:hover { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .estrip-card {
      transition: none;
    }
    .estrip-card:hover {
      transform: none;
    }
  }

  .estrip-date { display: flex; align-items: baseline; gap: 0.5rem; }
  .estrip-date .d {
    font-size: 1.5rem;
    font-weight: 600;
    color: #dc2626;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .estrip-date .m {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #a3a3a3;
  }

  /* daisyUI badge supplies shape + colour; this refines it to the dossier label
     idiom (uppercase, letter-spaced, small), matching the mockup. */
  .estrip-badge {
    align-self: flex-start;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.66rem;
    font-weight: 500;
  }

  .estrip-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.25;
    color: #e8e8e8;
    overflow-wrap: anywhere;
  }

  .estrip-desc {
    margin: 0;
    color: #a3a3a3;
    font-size: 0.86rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .estrip-loc {
    margin-top: auto;
    font-size: 0.82rem;
    color: #a3a3a3;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .see-all { margin: 1.6rem 0 0; }
  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: #fbbf24;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .see-all-link:hover { color: #fcd34d; text-decoration: underline; text-underline-offset: 2px; }
</style>
