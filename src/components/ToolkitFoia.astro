---
import foiaTemplates from '../data/toolkit-foia.json';
import foiaContacts from '../data/foia-contacts.json';

/**
 * Highlight [PLACEHOLDER] markers in template text with amber spans.
 */
function highlightPlaceholders(text: string): string {
  return text.replace(/\[([A-Z\s]+)\]/g, '<span class="text-[#fbbf24] font-semibold">[$1]</span>');
}
---

<!-- Zone 1: Agency Finder -->
<div class="mb-12">
  <h2 class="text-[#e8e8e8] font-bold text-xl md:text-2xl tracking-[-0.02em] mb-4">
    Find Your Agency &amp; Request Records
  </h2>
  <p class="text-[#d4d4d4] text-base leading-[1.7] mb-6">
    South Carolina's Freedom of Information Act
    (<a href="https://www.scstatehouse.gov/code/t30c004.php" target="_blank" rel="noopener" class="text-[#fbbf24] underline">S.C. Code &sect; 30-4-10</a>)
    gives every person the right to inspect and copy public records. Find the agency you want to request records from, then grab a template below.
  </p>

  <!-- Finder input -->
  <div id="foia-finder-input" class="bg-[rgba(255,255,255,0.04)] border border-[rgba(255,255,255,0.07)] p-6 mb-6">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-4 mb-4">
      <button id="foia-geo" type="button" class="btn btn-primary text-sm uppercase tracking-[0.08em] min-h-12 whitespace-nowrap">
        Use My Location
      </button>
      <div class="flex-1">
        <form id="foia-address-form" class="join w-full">
          <input
            id="foia-address"
            type="text"
            placeholder="Or enter your address..."
            class="input join-item flex-1 min-h-12"
            autocomplete="street-address"
          />
          <button type="submit" class="btn btn-neutral join-item min-h-12">Find</button>
        </form>
      </div>
    </div>
    <p class="text-[#525252] text-xs">
      Your location is matched entirely in your browser. No data is sent to any server.
    </p>
  </div>

  <!-- Loading state (hidden by default) -->
  <div id="foia-finder-loading" class="hidden text-center py-8">
    <span class="loading loading-spinner loading-md text-primary" aria-hidden="true"></span>
    <p class="text-[#a3a3a3] text-sm mt-3" role="status">Finding agencies near you...</p>
  </div>

  <!-- Error state (hidden by default) -->
  <div id="foia-finder-error" class="hidden mb-6">
    <div class="alert alert-error" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 shrink-0 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span id="foia-finder-error-msg"></span>
      <button id="foia-finder-retry" type="button" class="btn btn-outline btn-sm min-h-11">Try again</button>
    </div>
  </div>

  <!-- Results state (hidden by default) -->
  <div id="foia-finder-results" class="hidden mb-6" aria-live="polite">
    <div class="flex items-center justify-between mb-4">
      <h3 id="foia-results-heading" class="text-[#e8e8e8] font-semibold text-base"></h3>
      <button id="foia-finder-reset" type="button" class="text-[#a3a3a3] hover:text-white text-xs underline cursor-pointer">New search</button>
    </div>
    <div id="foia-results-list" class="space-y-3"></div>
  </div>

  <!-- Browse all agencies toggle -->
  <div class="border-t border-[rgba(255,255,255,0.07)] pt-4">
    <button id="foia-browse-toggle" type="button" class="text-[#a3a3a3] hover:text-white text-sm font-medium cursor-pointer flex items-center gap-2">
      <svg id="foia-browse-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
      Browse all agencies
    </button>
    <div id="foia-browse-panel" class="hidden mt-4">
      <div class="flex flex-wrap gap-2 mb-4">
        <input id="foia-search" type="text" placeholder="Search agencies..." class="input flex-1 min-w-[200px] min-h-12" />
        <div class="flex gap-1 flex-wrap" role="radiogroup" aria-label="Filter by agency type">
          <input type="radio" name="foia-type" value="all" aria-label="All" checked class="filter-chip foia-type-chip btn btn-sm min-h-11 text-xs uppercase tracking-[0.05em]" />
          <input type="radio" name="foia-type" value="police" aria-label="Police" class="filter-chip foia-type-chip btn btn-sm min-h-11 text-xs uppercase tracking-[0.05em]" />
          <input type="radio" name="foia-type" value="sheriff" aria-label="Sheriff" class="filter-chip foia-type-chip btn btn-sm min-h-11 text-xs uppercase tracking-[0.05em]" />
          <input type="radio" name="foia-type" value="clerk" aria-label="Clerk" class="filter-chip foia-type-chip btn btn-sm min-h-11 text-xs uppercase tracking-[0.05em]" />
          <input type="radio" name="foia-type" value="state" aria-label="State" class="filter-chip foia-type-chip btn btn-sm min-h-11 text-xs uppercase tracking-[0.05em]" />
        </div>
      </div>
      <div id="foia-browse-list" class="space-y-3 max-h-[60vh] overflow-y-auto"></div>
    </div>
  </div>
</div>

<!-- Pre-fill banner (hidden by default, shown when agency selected) -->
<div id="foia-prefill-banner" class="hidden mb-6">
  <div class="alert alert-warning" role="status">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 shrink-0 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    <span>Templates pre-filled for <strong id="foia-prefill-name"></strong></span>
    <button id="foia-prefill-clear" type="button" class="btn btn-outline btn-sm min-h-11">Clear</button>
  </div>
</div>

<!-- Sidebar + panel (replaces card grid) -->
<div class="foia-layout md:grid md:grid-cols-[280px_1fr] bg-[rgba(255,255,255,0.07)] mb-16" style="gap:1px">

  <!-- Template list (sidebar) -->
  <div class="bg-base-100" role="tablist" aria-label="FOIA templates" id="foia-rail">
    {foiaTemplates.map((tmpl: any, i: number) => (
      <button
        type="button"
        role="tab"
        id={`foia-tab-${i}`}
        aria-controls={`foia-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="rail-tab px-6 py-4 text-sm font-medium leading-[1.35]"
      >
        {tmpl.title}
      </button>
    ))}
  </div>

  <!-- Template panel -->
  <div class="bg-base-100 p-8 md:p-10">
    {foiaTemplates.map((tmpl: any, i: number) => (
      <div
        class="foia-panel"
        id={`foia-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`foia-tab-${i}`}
        hidden={i !== 0}
      >
        <h3 class="text-[#e8e8e8] font-bold text-lg mb-3">{tmpl.title}</h3>
        <p class="text-[#a3a3a3] text-sm leading-[1.6] mb-4">{tmpl.description}</p>

        <!-- Why this matters (inline, no accordion) -->
        <div class="rounded-[var(--radius-field)] border border-[rgba(255,255,255,0.09)] bg-[rgba(255,255,255,0.03)] p-3 mb-6">
          <p class="font-semibold text-sm text-[#a3a3a3] mb-1">Why this matters</p>
          <p class="text-[#a3a3a3] text-sm leading-[1.6]">{tmpl.why}</p>
        </div>

        <!-- Template text (flat, no nested box) -->
        <div
          class="template-text text-sm text-[#d4d4d4] leading-[1.7] whitespace-pre-wrap mb-6 border-t border-[rgba(255,255,255,0.07)] pt-6"
          set:html={highlightPlaceholders(tmpl.template)}
        />

        <!-- Actions -->
        <div class="flex flex-wrap gap-3">
          <button
            type="button"
            class="copy-btn btn btn-primary min-h-11 text-xs uppercase tracking-[0.1em]"
            data-template-id={tmpl.id}
          >
            Copy Template
          </button>
          <a
            href={`/toolkit/foia/${tmpl.id}.pdf`}
            class="inline-flex items-center text-sm font-semibold text-[#a3a3a3] hover:text-white transition-colors px-4 py-2.5"
            download
          >
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download PDF
          </a>
        </div>
      </div>
    ))}
  </div>
</div>

<!-- Filing instructions -->
<div class="border-t border-[rgba(255,255,255,0.07)] pt-10">
  <h2 class="text-[#e8e8e8] font-bold text-lg mb-4">How to File Your Request</h2>
  <ol class="text-[#d4d4d4] text-base leading-[1.8] list-decimal list-inside space-y-2">
    <li>
      <strong class="text-white">Find the records custodian.</strong> Search your agency's
      website for "FOIA" or "public records" to find the designated contact.
    </li>
    <li>
      <strong class="text-white">Fill in the template.</strong> Replace every bracketed
      field with your information and the agency's details.
    </li>
    <li>
      <strong class="text-white">Send it.</strong> Email is fastest. If you mail it,
      use certified mail so you have proof of delivery.
    </li>
    <li>
      <strong class="text-white">Track the deadline.</strong> The agency has 15 business
      days to respond. Mark your calendar.
    </li>
    <li>
      <strong class="text-white">Follow up.</strong> If you don't hear back, send a
      polite reminder citing the statutory deadline. If they deny your request, they must
      explain why in writing.
    </li>
  </ol>
</div>

<script type="application/json" id="foia-contacts-data" set:html={JSON.stringify(foiaContacts)}></script>

<script>
  import { initTabRail } from '../scripts/tab-rail';
  import { showToast } from '../scripts/toast';

  function initFoiaTab() {
    initTabRail('foia-rail');

    // Copy-to-clipboard
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const panel = btn.closest('.foia-panel');
        if (!panel) return;

        const templateEl = panel.querySelector('.template-text');
        if (!templateEl) return;

        const text = templateEl.textContent || '';

        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }

        showToast('Template copied to clipboard');
      });
    });
  }

  initFoiaTab();
  document.addEventListener('astro:after-swap', initFoiaTab);
</script>

<script>
  import '../scripts/foia-finder';
</script>
