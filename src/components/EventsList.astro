---
import type { Occurrence } from '../lib/events-view.js';
import { monthAbbr, dayOfMonth, formatTime12, sortKey, emptyStateProof, recurrenceLabel, eventTypeLabel, eventTypeSlug } from '../lib/events-view.js';

interface Props {
  upcoming: Occurrence[];
  past: Occurrence[];
  cityNames: Record<string, string>;
  countyNames: Record<string, string>;
  // Homepage preview cap. When set (variant="home" passes 6), only the first
  // `limit` upcoming rows render and a "see all" link points at /events; on
  // /events it is undefined and the full list renders exactly as before.
  limit?: number;
}

const { upcoming, past, cityNames, countyNames, limit } = Astro.props;

// The homepage preview shows a hard-capped slice; /events (limit undefined)
// shows every upcoming row, identical to before this prop existed.
const shownUpcoming = limit != null ? upcoming.slice(0, limit) : upcoming;

const place = (o: Occurrence) =>
  `${cityNames[o.event.city] ?? o.event.city} · ${countyNames[o.event.county] ?? o.event.county} County`;
---

<div class="events-list-wrap">
  {/* The live region is this short "N upcoming" summary, NOT the list below.
      applyFilter/syncChrome rewrite #events-count as the filter narrows, so a
      screen reader hears a concise "5 upcoming" — aria-atomic makes it read the
      whole line, not the bare number. aria-live used to sit on the <ul>, which
      re-announced all 30+ cards every time the type radiogroup was arrowed. */}
  <p class="events-count label-mono tabular-nums text-[#737373]" aria-live="polite" aria-atomic="true">
    <span id="events-count">{shownUpcoming.length}</span> upcoming
  </p>

  <ul id="events-list" class="events-list">
    {shownUpcoming.map((o) => (
      <li
        id={o.event.id}
        class={`event-card event-card--${eventTypeSlug(o.event.type)}`}
        data-event-id={o.event.id}
        data-date={o.date}
        data-sort={sortKey(o.date, o.event.time, o.event.id)}
      >
        <div class="event-date" aria-hidden="true">
          <span class="event-date-day">{dayOfMonth(o.date)}</span>
          <span class="event-date-mon">{monthAbbr(o.date)}</span>
        </div>
        <div class="event-body">
          <h3 class="event-title">
            <button type="button" class="event-title-btn" aria-haspopup="dialog">{o.event.title}</button>
          </h3>
          <p class="event-meta">
            <span class="sr-only">{o.date} </span>{formatTime12(o.event.time)} · {place(o)}
          </p>
          {o.event.address && <p class="event-address">{o.event.address}</p>}
          {o.event.description && <p class="event-desc">{o.event.description}</p>}
          {/* Quiet type/recurrence line + inline Share, one flex row. MUST stay
              in class-parity with buildCard() in events-page.ts: a
              <div class="event-actions"> holding the <p class="event-typeline">
              (type label, " · Repeats …" appended for a collapsed series) and a
              .event-share-inline button (neutral grey, ~44px target). The Signal
              join lives only in the detail popover, never here. */}
          <div class="event-actions">
            <p class="event-typeline">
              {eventTypeLabel(o.event.type)}{recurrenceLabel(o.event.recurrence) ? ` · ${recurrenceLabel(o.event.recurrence)}` : ''}
            </p>
            <button type="button" class="event-share-inline" aria-label={`Share ${o.event.title}`}>
              <svg class="event-share-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              Share
            </button>
          </div>
        </div>
      </li>
    ))}
  </ul>

  {/* The homepage preview's one way out to the full explorer: rendered only when
      the list is capped (limit set). On /events (limit undefined) there is no cap
      and no link — the page already IS the full list. */}
  {limit != null && (
    <a class="events-see-all" href="/events">See all events <span aria-hidden="true">&rarr;</span></a>
  )}

  <!-- One empty state, two leads. A calendar empty to begin with keeps the
       general lead below (the no-JavaScript default); when the client filters to
       a specific county with nothing on it, events-page.ts rewrites the lead to
       name that county ("No events in Greenville County yet"). The proof line and
       the two ways in are shared, and the proof comes from emptyStateProof() on
       both render paths. -->
  <div id="events-empty" class="events-empty" hidden={shownUpcoming.length > 0}>
    <p class="events-empty-lead" id="events-empty-lead">Nothing on the calendar right now.</p>
    <p class="events-empty-proof" id="events-empty-proof">{emptyStateProof(past.length)}</p>
    <p class="events-empty-actions">
      <a class="event-signal" href="/events/submit">Submit an event</a>
      <a class="event-signal" href="mailto:deflocksc@proton.me">Email us</a>
      <button id="intake-open" type="button" class="event-signal event-signal-btn">Join the Signal group</button>
    </p>
  </div>

  <details class="events-past" id="events-past" hidden={past.length === 0}>
    <summary class="label-mono tabular-nums">
      Past events (<span id="events-past-count">{past.length}</span>)
    </summary>
    <ul class="events-past-list" id="events-past-list">
      {past.map((o) => (
        <li class="event-past-row">
          <span class="event-past-date">{monthAbbr(o.date)} {dayOfMonth(o.date)}</span>
          <span class="event-title event-past-title">{o.event.title}</span>
          <span class="event-past-place">{place(o)}</span>
        </li>
      ))}
    </ul>
  </details>
</div>
