---
// Shared 4-card row linking to the /toolkit/* sub-pages. Self-contained and
// prop-free by default: rendered inside TakeActionZone on the homepage (§2.6a)
// and reused on the toolkit index page. It renders only the card row (no
// section wrapper or heading), so each consumer supplies its own surrounding
// context. The row carries its own data-reveal so it animates in wherever it
// is placed.
//
// The `detailed` prop (used only by the toolkit hub) adds a red icon well to
// each card for more presence; the homepage row stays concise (icon-less).
// Copy is verbatim from the approved homepage mockup
// (docs/plans/assets/2026-08-30-homepage-mockup.html). Each card is a real <a>;
// the cards are a list of links, so they live in a <ul>.

interface ToolkitCard {
  title: string;
  href: string;
  desc: string;
  badge: string;
  icon: 'file' | 'mic' | 'mega' | 'scale';
}

interface Props {
  /** Toolkit hub passes this to add the icon well; homepage stays concise. */
  detailed?: boolean;
}
const { detailed = false } = Astro.props;

const cards: ToolkitCard[] = [
  {
    title: 'FOIA templates',
    href: '/toolkit/foia',
    desc: 'Ready-to-send public-records letters for any SC agency running Flock.',
    badge: 'Templates',
    icon: 'file',
  },
  {
    title: 'Public-comment scripts',
    href: '/toolkit/speaking',
    desc: 'Three-minute remarks you can adapt and read straight from the podium.',
    badge: 'Scripts',
    icon: 'mic',
  },
  {
    title: 'Outreach materials',
    href: '/toolkit/outreach',
    desc: 'Flyers, briefs, and social graphics to rally your neighbors before the vote.',
    badge: 'Print + social',
    icon: 'mega',
  },
  {
    title: 'Know your rights',
    href: '/toolkit/legal',
    desc: "What SC law does and doesn't allow, and what to say when you're recording in public.",
    badge: 'Legal',
    icon: 'scale',
  },
];
---

{detailed && (
  <svg class="tk-sprite" width="0" height="0" aria-hidden="true" focusable="false"><defs>
    <g id="tk-i-file" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /><path d="M9 13h6M9 17h4" /></g>
    <g id="tk-i-mic" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z" /><path d="M5 10a7 7 0 0 0 14 0" /><path d="M8 21h8M12 17v4" /></g>
    <g id="tk-i-mega" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a3 3 0 0 1 0 6" /><path d="M10 8H7a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h3l6 4V4z" /></g>
    <g id="tk-i-scale" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 20h10M12 4v16M6 6l6-1 6 1" /><path d="M9 12L6 6l-3 6a3 3 0 0 0 6 0zM21 12l-3-6-3 6a3 3 0 0 0 6 0z" /></g>
  </defs></svg>
)}

<ul class="toolkit-row" data-reveal="up">
  {
    cards.map((card) => (
      <li class="min-w-0">
        <a href={card.href} class="tk-card">
          {detailed && (
            <span class="tk-well" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href={`#tk-i-${card.icon}`} /></svg>
            </span>
          )}
          <span class="tk-head">
            <span class="tk-title">{card.title}</span>
            <span class="tk-arrow" aria-hidden="true">&rarr;</span>
          </span>
          <span class="tk-desc">{card.desc}</span>
          <span class="tk-badges">
            <span class="tk-badge">{card.badge}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* 4 columns, collapsing to 2 below 900px and 1 below 480px (mockup §2.6a). */
  .toolkit-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 900px) {
    .toolkit-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .toolkit-row {
      grid-template-columns: 1fr;
    }
  }

  .tk-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    min-width: 0;
    padding: 1.05rem 1.1rem;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.3rem;
    color: inherit;
    text-decoration: none;
    /* Border brighten + background lift on hover (any pointer); the translate
       and arrow slide below are gated to hover-capable pointers only. */
    transition:
      border-color 0.18s cubic-bezier(0.23, 1, 0.32, 1),
      background 0.18s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .tk-card:hover {
    border-color: rgba(255, 255, 255, 0.22);
    background: #1e1e1e;
  }

  /* Icon well (detailed variant only). */
  .tk-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .tk-well {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.45rem;
    background: #141414;
    color: #ef4444;
  }
  .tk-well svg {
    width: 20px;
    height: 20px;
  }

  .tk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .tk-title {
    color: #e8e8e8;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.25;
  }
  .tk-arrow {
    flex: none;
    color: #dc2626;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .tk-desc {
    color: #a3a3a3;
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .tk-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.15rem;
  }
  .tk-badge {
    display: inline-flex;
    align-items: center;
    height: 1.55rem;
    padding: 0 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.3rem;
    color: #a3a3a3;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .tk-card:hover {
      transform: translateY(-2px);
    }
    .tk-card:hover .tk-arrow {
      transform: translateX(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-card,
    .tk-arrow {
      transition: none;
    }
    .tk-card:hover,
    .tk-card:hover .tk-arrow {
      transform: none;
    }
  }
</style>
