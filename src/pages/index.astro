---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BlogCarousel from '../components/BlogCarousel.astro';
import ImpactBand from '../components/ImpactBand.astro';
import MapSection from '../components/MapSection.astro';
import LegislationAsks from '../components/LegislationAsks.astro';
import TakeActionZone from '../components/TakeActionZone.astro';
import HomeEvents from '../components/HomeEvents.astro';
import SignalCta from '../components/SignalCta.astro';
import impactStats from '../data/impact-stats.json';

// Statewide meta description on the camera floor (design §4.1/§10 resolution #10).
// The exact SC total is computed at build into impact-stats.json; round it down
// to a "more than N" floor so the copy stays true between refreshes and never
// hardcodes a camera number in markup. Matches the hero support line's floor.
const cameraFloor = (Math.floor(impactStats.scTotal / 100) * 100).toLocaleString('en-US');
const description = `More than ${cameraFloor} ALPR cameras track where South Carolinians drive, with no state law on who can look or how long the data is kept. See the map and find your representatives.`;
---

<Base title="DeflockSC — Stop License Plate Surveillance in South Carolina" description={description}>
  <Hero />
  <ImpactBand />
  <MapSection />
  <LegislationAsks />
  <TakeActionZone />
  <HomeEvents />
  <BlogCarousel />
  <SignalCta />
</Base>
